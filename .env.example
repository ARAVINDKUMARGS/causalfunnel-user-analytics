# ==========================================
# CausalFunnel Analytics Monorepo Environment
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local instance default:
MONGODB_URI=mongodb://127.0.0.1:27017/causalfunnel_analytics
# Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/causalfunnel_analytics?retryWrites=true&w=majority

# CORS Configuration
# Comma-separated list of allowed origins (leave * for local dev or specify exact ports)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Ingestion Rate Limiting (requests per 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Frontend Dashboard Configuration
VITE_API_URL=http://localhost:5000
